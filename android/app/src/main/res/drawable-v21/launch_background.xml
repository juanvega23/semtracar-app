<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de arranque (API 21+): fondo blanco + logo de Semtracar centrado.
     Se fija blanco en vez de ?android:colorBackground para que el logo se vea
     igual en modo claro y oscuro; la UI de la app es clara en ambos casos. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
