<?xml version="1.0" encoding="utf-8"?>
<!-- Icono adaptativo (Android 8+): placa blanca + swoosh de Semtracar.
     Android recorta el icono con la mascara del launcher (circulo, squircle,
     etc.), por eso el swoosh vive dentro de los 72dp centrales del lienzo
     de 108dp. Android 12+ tambien usa este foreground como icono del splash. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
